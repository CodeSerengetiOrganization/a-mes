# Copy to .env and fill password (from deploy/k3s/mysql/mysql-secret.yaml).
# .env is gitignored — never commit secrets.
#
# IntelliJ: Run → Edit Configurations → "mes-api (dev)"
#   - Active profiles: dev
#   - EnvFile (plugin) loads this .env, OR set MYSQL_PASSWORD in Environment variables
#
SPRING_PROFILES_ACTIVE=dev

# MySQL (port-forward: kubectl port-forward -n ames-dev svc/ames-mysql 3306:3306)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ames
MYSQL_PASSWORD=CHANGE_ME
