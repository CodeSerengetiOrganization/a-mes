# Copy to mysql-secret.yaml (gitignored) and set real values before deploy.
# Single source of truth for DB name / app user / passwords (wired as MYSQL_* env on the StatefulSet).
# Do not commit real passwords. Local mysql-secret.yaml may keep your current dev values.
apiVersion: v1
kind: Secret
metadata:
  name: mysql-secret
  namespace: ames-dev
type: Opaque
stringData:
  mysql-root-password: "CHANGE_ME"
  mysql-database: "ames"
  mysql-user: "ames"
  mysql-password: "CHANGE_ME"
