# Copy to mes-api-db-secret.yaml (gitignored) and set real values before deploy.
# Must match deploy/k3s/mysql/mysql-secret.yaml (ames user).
apiVersion: v1
kind: Secret
metadata:
  name: mes-api-db-secret
  namespace: ames-dev
type: Opaque
stringData:
  SPRING_DATASOURCE_USERNAME: "ames"
  SPRING_DATASOURCE_PASSWORD: "CHANGE_ME"
