# Copy to mes-api-ghcr-secret.yaml (gitignored) before deploy.
# Same dockerconfigjson as mes-prod GHCR pull secret; namespace is ames-dev.
apiVersion: v1
kind: Secret
metadata:
  name: mes-api-ghcr-secret
  namespace: ames-dev
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: CHANGE_ME
